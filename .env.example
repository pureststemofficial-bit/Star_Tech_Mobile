# Copy to .env and fill in. Never commit the real .env file.
# Next.js loads .env automatically.

# Number of reverse proxies in front of the app (1 behind Nginx / Caddy / Cloudflare).
# Used to find the real client IP for rate limiting.
TRUST_PROXY=1

# First admin account (only used when no admin exists yet).
# If ADMIN_PASSWORD is empty, a random password is printed once in the server log.
ADMIN_EMAIL=admin@startechmobile.co.uk
ADMIN_PASSWORD=

# Public address of the site. Used for the sitemap and for link previews on social media.
SITE_URL=https://www.yourshop.co.uk

# Where the SQLite database and uploaded images are stored (default: ./data)
# DATA_DIR=/var/lib/startech
